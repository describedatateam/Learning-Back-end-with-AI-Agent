DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Study tutor: works with your Claude Code login by default. An API key is optional.
# Backup (or only) tutor: a free Google Gemini key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# LEARN_GEMINI_MODEL=gemini-flash-latest
# ANTHROPIC_API_KEY=sk-ant-...
# LEARN_TUTOR_MODEL=claude-opus-5

# Deployment (PythonAnywhere etc.)
# LEARN_REQUIRE_LOGIN=True
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com
